modules = ["python-3.11", "python3", "nodejs-20", "postgresql-16"]
[agent]
expertMode = true
integrations = ["python_database:1.0.0", "python_anthropic:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["cacert", "cairo", "cargo", "freefont_ttf", "freetype", "gdk-pixbuf", "gitFull", "glib", "glibcLocales", "gobject-introspection", "imagemagick", "lcms2", "libffi", "libiconv", "libimagequant", "libjpeg", "libtiff", "libuv", "libwebp", "libxcrypt", "openjpeg", "pkg-config", "playwright-driver", "rustc", "tcl", "tk", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uvicorn main:app --host 0.0.0.0 --port 5000 --reload"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "5000"]
build = ["pip", "install", "-r", "requirements.txt"]

[userenv]

[userenv.development]
APP_BASE_URL = "https://4ab24e3a-e318-4ff7-8dab-80d71ab1b725-00-19fomh9w0v1z9.riker.replit.dev"

[userenv.shared]

[userenv.production]
ENVIRONMENT = "production"
