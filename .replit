modules = ["python-3.11", "python3", "postgresql-16"]
[agent]
expertMode = true
integrations = ["python_database:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "libxcrypt"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uvicorn main:app --host 0.0.0.0 --port 5000 --reload"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33565
externalPort = 8080

[[ports]]
localPort = 35115
externalPort = 3003

[[ports]]
localPort = 37301
externalPort = 6000

[[ports]]
localPort = 37827
externalPort = 5000

[[ports]]
localPort = 38091
externalPort = 5173

[[ports]]
localPort = 39101
externalPort = 8099

[[ports]]
localPort = 40151
externalPort = 8008

[[ports]]
localPort = 41713
externalPort = 3000

[[ports]]
localPort = 42779
externalPort = 3002

[[ports]]
localPort = 43695
externalPort = 8081

[[ports]]
localPort = 44353
externalPort = 3001

[[ports]]
localPort = 45127
externalPort = 8000

[[ports]]
localPort = 46169
externalPort = 6800

[[ports]]
localPort = 46397
externalPort = 4200

[deployment]
deploymentTarget = "autoscale"
run = ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "5000"]
