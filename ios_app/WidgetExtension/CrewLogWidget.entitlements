<?xml version="1.0" encoding="UTF-8"?>
<!-- Add this entitlements file to the CrewLogWidget target in Xcode.
     The host app target needs the SAME App Group + Keychain Sharing entries
     so both can read/write the shared keychain. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.app.crewlog.mobile</string>
    </array>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)app.crewlog.mobile</string>
    </array>
</dict>
</plist>
